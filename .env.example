# Gateway
PORT=8000
NODE_ENV=development
LOG_LEVEL=info

# JWT (Grup 2 ile ortak secret/algoritma belirlenecek; gerçek değeri commit etme)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# Arka servis adresleri
AUTH_URL=http://localhost:8001
EVENT_URL=http://localhost:8002
REGISTRATION_URL=http://localhost:8003
LIVE_WS_URL=ws://localhost:8006

# Gateway dayanıklılığı
REQUEST_TIMEOUT_MS=5000

# Frontend
VITE_API_BASE_URL=http://localhost:8000